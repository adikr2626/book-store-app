# ==========================================
# Stage 1: Build & Cache Dependencies
# ==========================================
FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /workspace/book-app

# Copy build wrappers and configuration
COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .

# Download dependencies to cache them in the Docker layer
RUN ./mvnw dependency:go-offline -B

# Copy source code and build the executable JAR file
COPY src src
RUN ./mvnw clean package -DskipTests

# ==========================================
# Stage 2: Minimal Secure Runtime
# ==========================================
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Create a secure non-root system user and group
RUN addgroup --system springgroup && adduser --system springuser --ingroup springgroup

# Copy only the compiled JAR file from the builder stage
COPY --from=builder /workspace/app/target/*.jar app.jar

# Change ownership of the runtime directory to the non-root user
RUN chown -R springuser:springgroup /app

# Switch executing context to the secure user
USER springuser

# Document the runtime port mapping
EXPOSE 8080

# Configure JVM flags optimized for container resource constraints
ENTRYPOINT ["java", "-XX:+UseG1GC", "-XX:+ExitOnOutOfMemoryError", "-jar", "app.jar"]
